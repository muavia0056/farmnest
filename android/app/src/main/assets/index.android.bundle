stmentGuidelineHeroSub:{en:"Follow these key principles before investing in any farmer's land",ur:'\u06a9\u0633\u06cc \u0628\u06be\u06cc \u06a9\u0633\u0627\u0646 \u06a9\u06cc \u0632\u0645\u06cc\u0646 \u0645\u06cc\u06ba \u0633\u0631\u0645\u0627\u06cc\u06c1 \u06a9\u0627\u0631\u06cc \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0627\u0646 \u0627\u06c1\u0645 \u0627\u0635\u0648\u0644\u0648\u06ba \u067e\u0631 \u0639\u0645\u0644 \u06a9\u0631\u06cc\u06ba'},investmentGuidelineIntro:{en:"Before investing in a farmer's land, carefully evaluate whether the land and the farmer have strong potential for a safe and profitable return.",ur:'\u06a9\u0633\u0627\u0646 \u06a9\u06cc \u0632\u0645\u06cc\u0646 \u0645\u06cc\u06ba \u0633\u0631\u0645\u0627\u06cc\u06c1 \u06a9\u0627\u0631\u06cc \u0633\u06d2 \u067e\u06c1\u0644\u06d2\u060c \u06cc\u06c1 \u0627\u062d\u062a\u06cc\u0627\u0637 \u0633\u06d2 \u062c\u0627\u0626\u0632\u06c1 \u0644\u06cc\u06ba \u06a9\u06c1 \u0622\u06cc\u0627 \u0632\u0645\u06cc\u0646 \u0627\u0648\u0631 \u06a9\u0633\u0627\u0646 \u0645\u06cc\u06ba \u0645\u062d\u0641\u0648\u0638 \u0627\u0648\u0631 \u0645\u0646\u0627\u0641\u0639 \u0628\u062e\u0634 \u0648\u0627\u067e\u0633\u06cc \u06a9\u06cc \u0645\u0636\u0628\u0648\u0637 \u0635\u0644\u0627\u062d\u06cc\u062a \u06c1\u06d2\u06d4'},investmentGuidelineGoldenRule:{en:'\u2705 Golden Rule of Investment',ur:'\u2705 \u0633\u0631\u0645\u0627\u06cc\u06c1 \u06a9\u0627\u0631\u06cc \u06a9\u0627 \u0633\u0646\u06c1\u0631\u06cc \u0627\u0635\u0648\u0644'},investmentGuidelineSummary1:{en:'\ud83c\udf31  The land must be productive',ur:'\ud83c\udf31  \u0632\u0645\u06cc\u0646 \u0632\u0631\u062e\u06cc\u0632 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2'},investmentGuidelineSummary2:{en:'\ud83e\udd1d  The farmer must be reliable',ur:'\ud83e\udd1d  \u06a9\u0633\u0627\u0646 \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2'},investmentGuidelineSummary3:{en:'\ud83d\udcc8  The crop must have market potential',ur:'\ud83d\udcc8  \u0641\u0635\u0644 \u0645\u06cc\u06ba \u0645\u0627\u0631\u06a9\u06cc\u0679 \u06a9\u06cc \u0635\u0644\u0627\u062d\u06cc\u062a \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2'},investmentGuidelineSummary4:{en:'\u2696\ufe0f  The overall risk must be manageable',ur:'\u2696\ufe0f  \u0645\u062c\u0645\u0648\u0639\u06cc \u062e\u0637\u0631\u06c1 \u0642\u0627\u0628\u0644 \u0627\u0646\u062a\u0638\u0627\u0645 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2'},investmentGuidelineSummaryFooter:{en:'Good investment decisions should be based on both opportunity and caution.',ur:'\u0627\u0686\u06be\u06d2 \u0633\u0631\u0645\u0627\u06cc\u06c1 \u06a9\u0627\u0631\u06cc \u0641\u06cc\u0635\u0644\u06d2 \u0645\u0648\u0642\u0639 \u0627\u0648\u0631 \u0627\u062d\u062a\u06cc\u0627\u0637 \u062f\u0648\u0646\u0648\u06ba \u067e\u0631 \u0645\u0628\u0646\u06cc \u06c1\u0648\u0646\u06d2 \u0686\u0627\u06c1\u0626\u06cc\u06ba\u06d4'},investmentGuidelineContact:{en:'For more guidelines, contact ',ur:'\u0645\u0632\u06cc\u062f \u0631\u06c1\u0646\u0645\u0627 \u0627\u0635\u0648\u0644\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba '},investmentGuidelineWarning:{en:'Please send payment to Farm Nest Admin account only. Double-check all details before sending.',ur:'\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0635\u0631\u0641 Farm Nest \u0627\u06cc\u0688\u0645\u0646 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u06cc\u06ba \u0628\u06be\u06cc\u062c\u06cc\u06ba\u06d4 \u0628\u06be\u06cc\u062c\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u062a\u0645\u0627\u0645 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0648\u0628\u0627\u0631\u06c1 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4'},dailyLimitInfo:{en:'You can only create 3 posts per day. You cannot create more than this.',ur:'\u0622\u067e \u0635\u0631\u0641 \u0631\u0648\u0632\u0627\u0646\u06c1 3 \u067e\u0648\u0633\u0679 \u0628\u0646\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u0633 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0646\u06c1\u06cc\u06ba \u0628\u0646\u0627 \u0633\u06a9\u062a\u06d2\u06d4'},postsToday:{en:'Posts today:',ur:'\u0622\u062c \u06a9\u06cc \u067e\u0648\u0633\u0679\u0633:'},dailyLimitReachedTitle:{en:'Daily Limit Reached',ur:'\u0631\u0648\u0632\u0627\u0646\u06c1 \u06a9\u06cc \u062d\u062f \u067e\u0648\u0631\u06cc \u06c1\u0648\u06af\u0626\u06cc'},dailyLimitReachedBody:{en:'You have reached your daily limit of 3 posts.',ur:'\u0622\u067e \u0646\u06d2 \u0631\u0648\u0632\u0627\u0646\u06c1 \u06a9\u06cc 3 \u067e\u0648\u0633\u0679\u0633 \u06a9\u06cc \u062d\u062f \u067e\u0648\u0631\u06cc \u06a9\u0631\u0644\u06cc \u06c1\u06d2\u06d4'},dailyLimitResetOn:{en:'Your limit will reset on',ur:'\u0622\u067e \u06a9\u06cc \u062d\u062f \u062f\u0648\u0628\u0627\u0631\u06c1 \u06c1\u0648\u06af\u06cc'},dailyLimitTimeRemaining:{en:'Time remaining:',ur:'\u0628\u0627\u0642\u06cc \u0648\u0642\u062a:'},biddingEnded:{en:'\u26d4 Bidding Ended',ur:'\u26d4 \u0628\u0648\u0644\u06cc \u062e\u062a\u0645 \u06c1\u0648\u06af\u0626\u06cc'},messageFarmerBtn:{en:'\ud83d\udcac Message',ur:'\ud83d\udcac \u067e\u06cc\u063a\u0627\u0645'},messageFarmerAlone:{en:'\ud83d\udcac Message Farmer',ur:'\ud83d\udcac \u06a9\u0633\u0627\u0646 \u06a9\u0648 \u067e\u06cc\u063a\u0627\u0645 \u06a9\u0631\u06cc\u06ba'},approveLabel:{en:'Approve',ur:'\u0645\u0646\u0638\u0648\u0631 \u06a9\u0631\u06cc\u06ba'},clickNow:{en:'Click Now',ur:'\u0627\u0628\u06be\u06cc \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba'},payWithinTime:{en:'\u23f1 Pay within:',ur:'\u23f1 \u0648\u0642\u062a \u067e\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u06cc\u06ba:'},paymentTimeExpired:{en:'\u26d4 Payment Time Expired',ur:'\u26d4 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0627 \u0648\u0642\u062a \u062e\u062a\u0645 \u06c1\u0648\u06af\u06cc\u0627'},paymentWarning:{en:'\u26a0\ufe0f You must confirm payment within 24 hours of winning. If payment is not made in time, your order will be automatically canceled and the item will go back to bidding.',ur:'\u26a0\ufe0f \u062c\u06cc\u062a\u0646\u06d2 \u06a9\u06d2 24 \u06af\u06be\u0646\u0679\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u0646\u0627 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4 \u0627\u06af\u0631 \u0648\u0642\u062a \u067e\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0646\u06c1 \u06c1\u0648\u0626\u06cc \u062a\u0648 \u0622\u067e \u06a9\u0627 \u0622\u0631\u0688\u0631 \u062e\u0648\u062f\u06a9\u0627\u0631 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0646\u0633\u0648\u062e \u06c1\u0648\u062c\u0627\u0626\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u0622\u0626\u0679\u0645 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0628\u0648\u0644\u06cc \u0645\u06cc\u06ba \u0686\u0644\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4'},paymentTimerSetup:{en:'\u23f3 24h payment timer is being set up...',ur:'\u23f3 24 \u06af\u06be\u0646\u0679\u06d2 \u06a9\u0627 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0679\u0627\u0626\u0645\u0631 \u062a\u0631\u062a\u06cc\u0628 \u062f\u06cc\u0627 \u062c\u0627 \u0631\u06c1\u0627 \u06c1\u06d2...'},paymentConfirmationTitle:{en:'Payment Confirmation',ur:'\u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642'},paymentConfirmationMsg:{en:"The payment will be transferred to Farm Nest Admin's account. Please carefully check the name and details before sending the payment. Farm Nest will not be responsible for any incorrect payment.",ur:'\u0627\u062f\u0627\u0626\u06cc\u06af\u06cc Farm Nest \u0627\u06cc\u0688\u0645\u0646 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u06cc\u06ba \u0645\u0646\u062a\u0642\u0644 \u06c1\u0648\u06af\u06cc\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0628\u06be\u06cc\u062c\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0646\u0627\u0645 \u0627\u0648\u0631 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0627\u062d\u062a\u06cc\u0627\u0637 \u0633\u06d2 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 Farm Nest \u06a9\u0633\u06cc \u063a\u0644\u0637 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u0630\u0645\u06c1 \u062f\u0627\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u06cc\u06d4'},iUnderstand:{en:'I Understand',ur:'\u0645\u06cc\u06ba \u0633\u0645\u062c\u06be \u06af\u06cc\u0627'},paymentDetailsTitle:{en:'Payment Details',ur:'\u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a'},mobileWallets:{en:'Mobile Wallets',ur:'\u0645\u0648\u0628\u0627\u0626\u0644 \u0648\u0627\u0644\u0679'},bankAccounts:{en:'Bank Accounts',ur:'\u0628\u06cc\u0646\u06a9 \u0627\u06a9\u0627\u0624\u0646\u0679\u0633'},accountNameLabel:{en:'Account Name',ur:'\u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u0627 \u0646\u0627\u0645'},accountNumberDetail:{en:'Account Number',ur:'\u0627\u06a9\u0627\u0624\u0646\u0679 \u0646\u0645\u0628\u0631'},ibanLabel:{en:'IBAN',ur:'IBAN'},paymentSentSelf:{en:'You have sent the payment to Farm Nest account.',ur:'\u0622\u067e \u0646\u06d2 Farm Nest \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u06cc\u06ba \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0628\u06be\u06cc\u062c \u062f\u06cc \u06c1\u06d2\u06d4'},paymentSentFarmer:{en:'The buyer has sent the payment to Farm Nest account. The amount will remain on hold for 7 days.',ur:'\u062e\u0631\u06cc\u062f\u0627\u0631 \u0646\u06d2 Farm Nest \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u06cc\u06ba \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0628\u06be\u06cc\u062c \u062f\u06cc \u06c1\u06d2\u06d4 \u0631\u0642\u0645 7 \u062f\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u0648\u0644\u0688 \u067e\u0631 \u0631\u06c1\u06d2 \u06af\u06cc\u06d4'},paymentAmountLabel:{en:'Amount: PKR ',ur:'\u0631\u0642\u0645: PKR '},backBtn:{en:'<- Back',ur:'-> \u0648\u0627\u067e\u0633'},amountLabel:{en:'Amount: PKR ',ur:'\u0631\u0642\u0645: PKR '},cancelOrderNotif:{en:'Your order was automatically canceled because payment was not made within 24 hours.',ur:'\u0622\u067e \u06a9\u0627 \u0622\u0631\u0688\u0631 \u062e\u0648\u062f\u06a9\u0627\u0631 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0646\u0633\u0648\u062e \u06c1\u0648\u06af\u06cc\u0627 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 24 \u06af\u06be\u0646\u0679\u0648\u06ba \u0645\u06cc\u06ba \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u0626\u06cc\u06d4'},fileError:{en:'Please upload the required file.',ur:'\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0645\u0637\u0644\u0648\u0628\u06c1 \u0641\u0627\u0626\u0644 \u0627\u067e\u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba\u06d4'},yourRatingLabel:{en:'Your Rating',ur:'\u0622\u067e \u06a9\u06cc \u0631\u06cc\u0679\u0646\u06af'},notifDetailTitle:{en:'\ud83d\udd14 Notification',ur:'\ud83d\udd14 \u0627\u0637\u0644\u0627\u0639'},notifReceived:{en:'\ud83d\udd50 Received',ur:'\ud83d\udd50 \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u0626\u06cc'},notifRead:{en:'\u2713 Read',ur:'\u2713 \u067e\u0691\u06be\u06cc \u06af\u0626\u06cc'},notifUnread:{en:'\u25cf Unread',ur:'\u25cf \u0646\u06c1\u06cc\u06ba \u067e\u0691\u06be\u06cc'},penaltyStatus:{en:'\u26a0\ufe0f Penalty Status',ur:'\u26a0\ufe0f \u062c\u0631\u0645\u0627\u0646\u06d2 \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a'},penaltiesReceived:{en:'penalties received',ur:'\u062c\u0631\u0645\u0627\u0646\u06d2 \u0645\u0644\u06d2'},penaltyAccountSuspendWarning:{en:'\ud83d\udeab Your account may be suspended after 3 penalties.',ur:'\ud83d\udeab 3 \u062c\u0631\u0645\u0627\u0646\u0648\u06ba \u06a9\u06d2 \u0628\u0639\u062f \u0622\u067e \u06a9\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u0639\u0637\u0644 \u06c1\u0648 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4'},penaltyInfoLink:{en:'What are penalties? Tap to learn more',ur:'\u062c\u0631\u0645\u0627\u0646\u06d2 \u06a9\u06cc\u0627 \u06c1\u06cc\u06ba\u061f \u0645\u0632\u06cc\u062f \u062c\u0627\u0646\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0679\u06cc\u067e \u06a9\u0631\u06cc\u06ba'},penaltySystemTitle:{en:'\u26a0\ufe0f Penalty System',ur:'\u26a0\ufe0f \u062c\u0631\u0645\u0627\u0646\u06c1 \u0646\u0638\u0627\u0645'},penaltySystemBody:{en:'If you have received a penalty, it means you either cancelled an order after winning a bid, or failed to send the payment to the Farmnest account within 24 hours.',ur:'\u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u062c\u0631\u0645\u0627\u0646\u06c1 \u0645\u0644\u0627 \u06c1\u06d2\u060c \u062a\u0648 \u0627\u0633 \u06a9\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0646\u06d2 \u0628\u0648\u0644\u06cc \u062c\u06cc\u062a\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u0622\u0631\u0688\u0631 \u0645\u0646\u0633\u0648\u062e \u06a9\u06cc\u0627\u060c \u06cc\u0627 24 \u06af\u06be\u0646\u0679\u0648\u06ba \u0645\u06cc\u06ba Farmnest \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u06cc\u06ba \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0646\u06c1\u06cc\u06ba \u0628\u06be\u06cc\u062c\u06cc\u06d4'},penaltyFirst:{en:'\u2022 1st penalty: Warning',ur:'\u2022 \u067e\u06c1\u0644\u0627 \u062c\u0631\u0645\u0627\u0646\u06c1: \u062a\u0646\u0628\u06cc\u06c1'},penaltySecond:{en:'\u2022 2nd penalty: Warning',ur:'\u2022 \u062f\u0648\u0633\u0631\u0627 \u062c\u0631\u0645\u0627\u0646\u06c1: \u062a\u0646\u0628\u06cc\u06c1'},penaltyThird:{en:'\u2022 3rd consecutive penalty: Account automatically suspended',ur:'\u2022 \u062a\u06cc\u0633\u0631\u0627 \u0644\u06af\u0627\u062a\u0627\u0631 \u062c\u0631\u0645\u0627\u0646\u06c1: \u0627\u06a9\u0627\u0624\u0646\u0679 \u062e\u0648\u062f\u06a9\u0627\u0631 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0639\u0637\u0644'},penaltyGotIt:{en:'Got it',ur:'\u0633\u0645\u062c\u06be \u06af\u06cc\u0627'},penaltyBuyerHas:{en:'This buyer has received',ur:'\u0627\u0633 \u062e\u0631\u06cc\u062f\u0627\u0631 \u06a9\u0648'},penaltyBuyerHasSuffix:{en:'penalty/penalties.',ur:'\u062c\u0631\u0645\u0627\u0646\u06d2 \u0645\u0644\u06d2 \u06c1\u06cc\u06ba\u06d4'},accountSuspendedTitle:{en:'Account Suspended',ur:'\u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u0639\u0637\u0644 \u06c1\u0648\u06af\u06cc\u0627'},accountSuspendedMsg:{en:'Your account has been suspended by the Admin. You can no longer access this platform.',ur:'\u0622\u067e \u06a9\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0627\u06cc\u0688\u0645\u0646 \u0646\u06d2 \u0645\u0639\u0637\u0644 \u06a9\u0631\u062f\u06cc\u0627 \u06c1\u06d2\u06d4 \u0622\u067e \u0627\u0628 \u0627\u0633 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0633\u06a9\u062a\u06d2\u06d4'},accountSuspendedSub:{en:'If you believe this is a mistake, please contact support.',ur:'\u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u0644\u06af\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06cc\u06c1 \u063a\u0644\u0637\u06cc \u06c1\u06d2 \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0633\u067e\u0648\u0631\u0679 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4'},backToLogin:{en:'Back to Login',ur:'\u0644\u0627\u06af \u0627\u0646 \u067e\u0631 \u0648\u0627\u067e\u0633 \u062c\u0627\u0626\u06cc\u06ba'},evTitle:{en:'Verify Your Email',ur:'\u0627\u067e\u0646\u06cc \u0627\u06cc \u0645\u06cc\u0644 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba'},evSubtitle:{en:'A 10-character code has been sent to your email. Enter it below to verify your account.',ur:'\u0622\u067e \u06a9\u06cc \u0627\u06cc \u0645\u06cc\u0644 \u067e\u0631 10 \u062d\u0631\u0648\u0641 \u06a9\u0627 \u06a9\u0648\u0688 \u0628\u06be\u06cc\u062c\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0627\u06a9\u0627\u0624\u0646\u0679 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0646\u06cc\u0686\u06d2 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4'},evSentTo:{en:'A verification code was sent to',ur:'\u062a\u0635\u062f\u06cc\u0642\u06cc \u06a9\u0648\u0688 \u0628\u06be\u06cc\u062c\u0627 \u06af\u06cc\u0627'},evVerifyBtn:{en:'\u2705 Verify & Continue',ur:'\u2705 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u062c\u0627\u0631\u06cc \u0631\u06a9\u06be\u06cc\u06ba'},evSkip:{en:'Skip for now \u2192 Go to Login',ur:'\u0627\u0628\u06be\u06cc \u0686\u06be\u0648\u0691\u06cc\u06ba \u2192 \u0644\u0627\u06af \u0627\u0646 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba'},evResendFailed:{en:'Failed to resend code.',ur:'\u06a9\u0648\u0688 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0628\u06be\u06cc\u062c\u0646\u0627 \u0646\u0627\u06a9\u0627\u0645 \u06c1\u0648\u0627\u06d4'},evSuccessTitle:{en:'Email Verified! \ud83c\udf89',ur:'\u0627\u06cc \u0645\u06cc\u0644 \u062a\u0635\u062f\u06cc\u0642 \u06c1\u0648\u06af\u0626\u06cc! \ud83c\udf89'},evSuccessMsg:{en:'Your email address has been verified successfully. Your account is now active and pending admin approval.',ur:'\u0622\u067e \u06a9\u06cc \u0627\u06cc \u0645\u06cc\u0644 \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u0633\u06d2 \u062a\u0635\u062f\u06cc\u0642 \u06c1\u0648\u06af\u0626\u06cc\u06d4 \u0622\u067e \u06a9\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0627\u0628 \u0641\u0639\u0627\u0644 \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u06cc\u0688\u0645\u0646 \u06a9\u06cc \u0645\u0646\u0638\u0648\u0631\u06cc \u06a9\u06d2 \u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u06cc\u06ba \u06c1\u06d2\u06d4'},evSuccessInfo:{en:'\ud83d\udd14 You will be notified once an admin reviews and approves your account. This usually takes 1\u20132 business days.',ur:'\ud83d\udd14 \u062c\u0628 \u0627\u06cc\u0688\u0645\u0646 \u0622\u067e \u06a9\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u0627 \u062c\u0627\u0626\u0632\u06c1 \u0644\u06d2 \u06a9\u0631 \u0645\u0646\u0638\u0648\u0631 \u06a9\u0631\u06d2 \u06af\u0627 \u062a\u0648 \u0622\u067e \u06a9\u0648 \u0645\u0637\u0644\u0639 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u06cc\u06c1 \u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 1\u20132 \u06a9\u0627\u0631\u0648\u0628\u0627\u0631\u06cc \u062f\u0646\u0648\u06ba \u0645\u06cc\u06ba \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4'},evGoToLogin:{en:'\u2192 Go to Login',ur:'\u2190 \u0644\u0627\u06af \u0627\u0646 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba'},evDemoTitle:{en:'Your Verification Code',ur:'\u0622\u067e \u06a9\u0627 \u062a\u0635\u062f\u06cc\u0642\u06cc \u06a9\u0648\u0688'},evDemoNote:{en:'Copy this code and paste it below. (Shown because email is in demo mode.)',ur:'\u06cc\u06c1 \u06a9\u0648\u0688 \u06a9\u0627\u067e\u06cc \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0646\u06cc\u0686\u06d2 \u067e\u06cc\u0633\u0679 \u06a9\u0631\u06cc\u06ba\u06d4 (\u0688\u06cc\u0645\u0648 \u0645\u0648\u0688 \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4)'},evLoginBlockNote:{en:'\ud83d\udd12 You must verify your email before you can log in. A fresh code has been sent to your email address.',ur:'\ud83d\udd12 \u0644\u0627\u06af \u0627\u0646 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0622\u067e \u06a9\u0648 \u0627\u067e\u0646\u06cc \u0627\u06cc \u0645\u06cc\u0644 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u0646\u06cc \u06c1\u0648\u06af\u06cc\u06d4 \u0622\u067e \u06a9\u06d2 \u0627\u06cc \u0645\u06cc\u0644 \u067e\u0631 \u0646\u06cc\u0627 \u06a9\u0648\u0688 \u0628\u06be\u06cc\u062c \u062f\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4'},menuSeeAllBidding:{en:'See All Bidding',ur:'\u062a\u0645\u0627\u0645 \u0628\u0648\u0644\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be\u06cc\u06ba'},seeAllBiddingTitle:{en:'See All Bidding',ur:'\u062a\u0645\u0627\u0645 \u0628\u0648\u0644\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be\u06cc\u06ba'},noBiddingActivity:{en:'No Bidding Activity',ur:'\u06a9\u0648\u0626\u06cc \u0628\u0648\u0644\u06cc \u0646\u06c1\u06cc\u06ba'},noBiddingSubtitle:{en:'When buyers bid on your crops, they will appear here in real time.',ur:'\u062c\u0628 \u062e\u0631\u06cc\u062f\u0627\u0631 \u0622\u067e \u06a9\u06cc \u0641\u0635\u0644\u0648\u06ba \u067e\u0631 \u0628\u0648\u0644\u06cc \u0644\u06af\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u06cc\u06c1\u0627\u06ba \u0646\u0638\u0631 \u0622\u0626\u06cc\u06ba \u06af\u06d2\u06d4'},biddersCount:{en:'Bidders',ur:'\u0628\u0648\u0644\u06cc \u0644\u06af\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2'},winnerLabel:{en:'Winner',ur:'\u0641\u0627\u062a\u062d'},selectedLabel:{en:'Selected',ur:'\u0645\u0646\u062a\u062e\u0628'},cancelOrderQ:{en:'Cancel Order?',ur:'\u0622\u0631\u0688\u0631 \u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u06cc\u06ba\u061f'},cancelOrderConfirmMsg:{en:"Are you sure you want to cancel this buyer's order? You will need to select another buyer.",ur:'\u06a9\u06cc\u0627 \u0622\u067e \u0648\u0627\u0642\u0639\u06cc \u0627\u0633 \u062e\u0631\u06cc\u062f\u0627\u0631 \u06a9\u0627 \u0622\u0631\u0688\u0631 \u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u061f \u0622\u067e \u06a9\u0648 \u062f\u0648\u0633\u0631\u06d2 \u062e\u0631\u06cc\u062f\u0627\u0631 \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u0627\u06d4'},selectBuyerQ:{en:'Select This Buyer?',ur:'\u062e\u0631\u06cc\u062f\u0627\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u061f'},selectBuyerBtn:{en:'Yes, Select',ur:'\u06c1\u0627\u06ba\u060c \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba'},buyerSelectedBanner:{en:'\u2705 Buyer selected. Awaiting payment confirmation.',ur:'\u2705 \u062e\u0631\u06cc\u062f\u0627\u0631 \u0645\u0646\u062a\u062e\u0628 \u06c1\u0648\u06af\u06cc\u0627\u06d4 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0627 \u0627\u0646\u062a\u0638\u0627\u0631 \u06c1\u06d2\u06d4'},orderCancelledSelectNew:{en:'Order cancelled. Now select another buyer.',ur:'\u0622\u0631\u0688\u0631 \u0645\u0646\u0633\u0648\u062e \u06c1\u0648\u06af\u06cc\u0627\u06d4 \u0627\u0628 \u062f\u0648\u0633\u0631\u06d2 \u062e\u0631\u06cc\u062f\u0627\u0631 \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4'},farmerSelectAnotherBuyer:{en:'The buyer did not make the payment. Please select another buyer from "See All Bidding".',ur:'\u062e\u0631\u06cc\u062f\u0627\u0631 \u0646\u06d2 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 "\u062a\u0645\u0627\u0645 \u0628\u0648\u0644\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be\u06cc\u06ba" \u0633\u06d2 \u062f\u0648\u0633\u0631\u0627 \u062e\u0631\u06cc\u062f\u0627\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4'},adminCancelSelectNew:{en:'The buyer did not send the payment. Please select another buyer from "See All Bidding".',ur:'\u062e\u0631\u06cc\u062f\u0627\u0631 \u0646\u06d2 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0646\u06c1\u06cc\u06ba \u0628\u06be\u06cc\u062c\u06cc\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 "\u062a\u0645\u0627\u0645 \u0628\u0648\u0644\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be\u06cc\u06ba" \u0633\u06d2 \u062f\u0648\u0633\u0631\u0627 \u062e\u0631\u06cc\u062f\u0627\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4'}},u=(0,n.createContext)(void 0);_e.LanguageProvider=function(e){var o=e.children,s=(0,n.useState)('en'),l=(0,r.default)(s,2),c=l[0],p=l[1];return(0,t.jsx)(u.Provider,{value:{language:c,toggleLanguage:function(){return p(function(e){return'en'===e?'ur':'en'})},t:function(e){var r,n;return null!=(r=null==(n=i[e])?void 0:n[c])?r:e},isUrdu:'ur'===c},children:o})},_e.useLanguage=function(){var e=(0,n.useContext)(u);if(!e)throw new Error('useLanguage must be used within LanguageProvider');return e}},798,[1,38,16,245]);
