countFound:{en:'No account found with this email address.',ur:'\u0627\u0633 \u0627\u06cc \u0645\u06cc\u0644 \u067e\u062a\u06d2 \u0633\u06d2 \u06a9\u0648\u0626\u06cc \u0627\u06a9\u0627\u0624\u0646\u0679 \u0646\u06c1\u06cc\u06ba \u0645\u0644\u0627\u06d4'},fpAdminNotAllowed:{en:'Password reset is not available for this account.',ur:'\u0627\u0633 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u0627\u0633 \u0648\u0631\u0688 \u0631\u06cc \u0633\u06cc\u0679 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4'},fpSendCodeBtn:{en:'Send Verification Code \u2192',ur:'\u2190 \u062a\u0635\u062f\u06cc\u0642\u06cc \u06a9\u0648\u0688 \u0628\u06be\u06cc\u062c\u06cc\u06ba'},fpSendFailed:{en:'Failed to send email. Please check your connection and try again.',ur:'\u0627\u06cc \u0645\u06cc\u0644 \u0628\u06be\u06cc\u062c\u0646\u0627 \u0646\u0627\u06a9\u0627\u0645 \u06c1\u0648\u0627\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u0627 \u06a9\u0646\u06a9\u0634\u0646 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4'},fpBackToLogin:{en:'\u2190 Back to Login',ur:'\u2192 \u0644\u0627\u06af \u0627\u0646 \u067e\u0631 \u0648\u0627\u067e\u0633'},fpStep2Label:{en:'Step 2 \u2014 Enter Verification Code',ur:'\u0645\u0631\u062d\u0644\u06c1 2 \u2014 \u062a\u0635\u062f\u06cc\u0642\u06cc \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba'},fpStep2Desc:{en:'A 10-character code has been sent to',ur:'10 \u062d\u0631\u0648\u0641 \u06a9\u0627 \u06a9\u0648\u0688 \u0628\u06be\u06cc\u062c\u0627 \u06af\u06cc\u0627 \u06c1\u06d2'},fpCodeLabel:{en:'Verification Code',ur:'\u062a\u0635\u062f\u06cc\u0642\u06cc \u06a9\u0648\u0688'},fpCodePlaceholder:{en:'Enter 10-character code',ur:'10 \u062d\u0631\u0648\u0641 \u06a9\u0627 \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba'},fpCodeRequired:{en:'Please enter the verification code.',ur:'\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062a\u0635\u062f\u06cc\u0642\u06cc \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4'},fpCodeInvalid:{en:'Incorrect code. Please check and try again.',ur:'\u063a\u0644\u0637 \u06a9\u0648\u0688\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4'},fpCodeExpired:{en:'This code has expired. Please request a new one.',ur:'\u06cc\u06c1 \u06a9\u0648\u0688 \u0645\u06cc\u0639\u0627\u062f \u062e\u062a\u0645 \u06c1\u0648\u06af\u0626\u06cc \u06c1\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0646\u06cc\u0627 \u06a9\u0648\u0688 \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba\u06d4'},fpCodeExpiredLabel:{en:'Code Expired \u2014 Request a new one below',ur:'\u06a9\u0648\u0688 \u06a9\u06cc \u0645\u06cc\u0639\u0627\u062f \u062e\u062a\u0645 \u2014 \u0646\u06cc\u0686\u06d2 \u0633\u06d2 \u0646\u06cc\u0627 \u06a9\u0648\u0688 \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba'},fpCodeExpiresIn:{en:'Code expires in',ur:'\u06a9\u0648\u0688 \u0645\u06cc\u0639\u0627\u062f \u062e\u062a\u0645 \u06c1\u0648\u06af\u0627'},fpVerifyCodeBtn:{en:'Verify Code \u2192',ur:'\u2190 \u06a9\u0648\u0688 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba'},fpDidntReceive:{en:"Didn't receive the code? ",ur:'\u06a9\u0648\u0688 \u0646\u06c1\u06cc\u06ba \u0645\u0644\u0627\u061f '},fpResendCode:{en:'Resend',ur:'\u062f\u0648\u0628\u0627\u0631\u06c1 \u0628\u06be\u06cc\u062c\u06cc\u06ba'},fpGoBack:{en:'\u2190 Go Back',ur:'\u2192 \u0648\u0627\u067e\u0633 \u062c\u0627\u0626\u06cc\u06ba'},fpStep3Label:{en:'Step 3 \u2014 Set New Password',ur:'\u0645\u0631\u062d\u0644\u06c1 3 \u2014 \u0646\u06cc\u0627 \u067e\u0627\u0633 \u0648\u0631\u0688 \u0633\u06cc\u0679 \u06a9\u0631\u06cc\u06ba'},fpStep3Desc:{en:'Create a strong new password for your account.',ur:'\u0627\u067e\u0