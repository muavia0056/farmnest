 Nest \xa9 2025',ur:'\u0641\u0627\u0631\u0645 \u0646\u06cc\u0633\u0679 \xa9 2025'},fieldRequired:{en:'This field is required.',ur:'\u06cc\u06c1 \u062e\u0627\u0646\u06c1 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4'},passwordRequired:{en:'Password is required.',ur:'\u067e\u0627\u0633 \u0648\u0631\u0688 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4'},noAccountFound:{en:'No account found with this information.',ur:'\u0627\u0633 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0633\u06d2 \u06a9\u0648\u0626\u06cc \u0627\u06a9\u0627\u0624\u0646\u0679 \u0646\u06c1\u06cc\u06ba \u0645\u0644\u0627\u06d4'},incorrectPassword:{en:'Incorrect password.',ur:'\u063a\u0644\u0637 \u067e\u0627\u0633 \u0648\u0631\u0688\u06d4'},accountSuspended:{en:'Your account has been suspended.',ur:'\u0622\u067e \u06a9\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u0639\u0637\u0644 \u06a9\u0631 \u062f\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4'},accountRejected:{en:'Your account has been rejected. Please contact support.',ur:'\u0622\u067e \u06a9\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u0633\u062a\u0631\u062f \u06a9\u0631 \u062f\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0633\u067e\u0648\u0631\u0679 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4'},adminAccountRejected:{en:'Your admin account has been rejected. Please contact the Main Admin.',ur:'\u0622\u067e \u06a9\u0627 \u0627\u06cc\u0688\u0645\u0646 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u0633\u062a\u0631\u062f \u06a9\u0631 \u062f\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0645\u0631\u06a9\u0632\u06cc \u0627\u06cc\u0688\u0645\u0646 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4'},identifierRequired:{en:'Email, Phone or CNIC is required.',ur:'\u0627\u06cc \u0645\u06cc\u0644\u060c \u0641\u0648\u0646 \u06cc\u0627 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\